# Copie este arquivo para ".env" e preencha com seus dados,
# ou preencha tudo pela tela de Configurações dentro do programa.

# Pegue API_ID e API_HASH em https://my.telegram.org -> API Development Tools
API_ID=
API_HASH=

# Canal do Telegram (ex: @nomedocanal)
CHANNEL=

# Limite de mensagens a escanear (deixe vazio para escanear tudo)
LIMIT=

# Pasta onde os vídeos baixados serão salvos
OUTPUT=

# Caminho/nome do arquivo de sessão do Telethon (sem extensão .session)
SESSION=tg_session
